      "current": "tbc",
      "url": "https://github.com/dan-leach/msf-diabetes/wiki/Contributors"
    }
  },
  "organisations": {
    "msf": {
      "shortName": "MSF Foundation",
      "fullName": "Médecins Sans Frontières Foundation",
      "main": "https://fondation.msf.fr/",
      "dkaGuidelines": "https://fondation.msf.fr/"
    }
  },
  "disclaimer": "Decisions about patient care remain the treating clinician's responsibility.",
  "api": {
    "repo": {
      "main": "https://github.com/dan-leach/msf-diabetes-api",
      "changelog": "https://github.com/dan-leach/msf-diabetes-api/wiki/Changelog"
    },
    "url": "https://dev-api.msf.dka-calculator.co.uk/",
    "timeoutDuration": 15000,
    "showConsole": true,
    "database": {
      "name": "msfdiabetes_data_v0",
      "users": {
        "select": "msfdiabetes_app_select",
        "insert": "msfdiabetes_app_insert"
      },
      "tables": {
        "calculate": "tbl_calculate",
        "decrypt": "tbl_decrypt"
      }
    }
  },
  "client": {
    "url": "https://msf.dka-calculator.co.uk",
    "sodiumOsmoUrl": "https://msf.dka-calculator.co.uk/sodium-osmo",
    "repo": {
      "main": "https://github.com/dan-leach/msf-diabetes",
      "changelog": "https://github.com/dan-leach/msf-diabetes/wiki/Changelog",
      "icpChangelog": "https://github.com/dan-leach/msf-diabetes/wiki/Integrated-Care-Pathway-(ICP)-Changelog"
    }
  },
  "validation": {
    "episodeType": {
      "options": ["real", "test"]
    },
    "patientSex": {
      "options": ["male", "female"]
    },
    "weight": {
      "min": 2,
      "max": 150
    },
    "patientAge": {
      "min": 0,
      "max": 19.01
    },
    "dropFactor": [
      {
        "type": "paediatric infusion set",
        "drops": 60
      },
      {
        "type": "adult infusion set",
        "drops": 20
      }
    ],
    "glucose": {
      "units": {
        "mg/dL": {
          "min": 200,
          "max": 900,
          "default": true
        },
        "mmol/L": {
          "min": 11.1,
          "max": 50
        }
      }
    },
    "bloodKetones": {
      "min": 3
    },
    "urineKetones": {
      "min": 2,
      "max": 4
    },
    "pH": {
      "min": 6.0,
      "max": 7.5,
      "diagnosticThreshold": 7.3,
      "severeThreshold": 7.1
    },
    "bicarbonate": {
      "min": 0,
      "max": 30,
      "diagnosticThreshold": 15
    },
    "gcs": {
      "min": 3,
      "max": 15,
      "severeThreshold": 12,
      "noBolusThreshold": 7
    }
  },
  "severity": {
    "severe": {
      "pHRange": {
        "upper": 7.1,
        "lower": 6.0
      },
      "deficitPercentage": 10
    },
    "standard": {
      "pHRange": {
        "upper": 7.3,
        "lower": 7.1
      },
      "bicarbonateBelow": 15,
      "deficitPercentage": 7.5
    }
  },
  "caps": {
    "weight": 75,
    "maintenance": 2600,
    "deficitSevere": 7500,
    "deficitStandard": 5625,
    "bolus": 750,
    "glucoseBolus": 150,
    "insulinRate01": 7.5,
    "insulinRate005": 3.75,
    "insulinDose02": 15,
    "insulinDose01": 7.5
  },
  "bolus": {
    "mlsPerKg": 10,
    "duration": {
      "shock": 15,
      "noShock": 60
    }
  },
  "insulin": {
    "ageThreshold": 2,
    "rateOptions": [0.05, 0.1],
    "doseOptions": [0.1, 0.2]
  },
  "decimals": {
    "bolusVolume": 0,
    "bolusRate": 0,
    "weight": 1,
    "deficitVolume": 1,
    "deficitRate": 1,
    "maintenanceVolume": 1,
    "maintenanceRate": 1,
    "bagSpeed": 0,
    "ivInsulinRate": 2,
    "age": 1,
    "imInsulinDose": 1,
    "drops": 0
  },
  "deficitReplacementDuration": 48,
